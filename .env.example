# ===== 必填 =====
# 管理页面登录密码（务必修改为强密码）
ADMIN_PASSWORD=change-me-please

# ===== 可选 =====
# 代理 API Key（客户端请求需携带相同 key；留空则不鉴权）
API_KEY=

# 数据目录（SQLite + 日志），默认 ./data
DATA_DIR=/data

# 每日签到时间（cron 表达式，Asia/Shanghai），默认每天 00:05
SIGNIN_CRON=5 0 * * *

# 补签轮询间隔 cron（未签才补 + 成长中心），默认每 6 小时
SIGNIN_POLL_CRON=0 */6 * * *

# 监听地址与端口（国际版默认 8789）
HOST=0.0.0.0
PORT=8789
